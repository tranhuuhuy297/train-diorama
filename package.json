{
  "name": "train-diorama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent from-scratch re-implementation of the Train Diorama Three.js scene",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/static-dev-server.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "check:lines": "node tools/check-file-line-limits.mjs",
    "parity:fetch": "node tools/parity/fetch-original-source.mjs --strict",
    "test:parity": "node --test --test-concurrency=1 \"tests/parity/*.test.mjs\"",
    "parity:capture": "node tools/parity/capture-parity-shots.mjs",
    "parity:compare": "node tools/parity/compare-parity-shots.mjs",
    "parity:probe": "node tools/parity/runtime-counts-probe.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "three": "0.186.0"
  }
}
